#!/usr/bin/env bun
// vim: ft=javascript

"use strict";

import path from "path";
import { statSync } from "node:fs";
import { readdir } from "node:fs/promises";

import { toTitleCase, faviconPath, escapeHtml } from "./utils";

if (Bun.argv.length < 3 || Bun.argv.length > 4) {
  console.error("Usage: gen_index <target file> [output root]");
  process.exit(1);
}

const constructRow = (item) => {
  const fullPath = `${item.path}/${item.name}`;
  const stats = statSync(fullPath);
  const nameWithoutExt = item.isDirectory()
    ? item.name
    : path.basename(item.name, path.extname(item.name));
  const href = `./${encodeURIComponent(item.name)}${item.isDirectory() ? "/" : ""}`;
  return `
<tr>
  <td><a href="${escapeHtml(href)}">${escapeHtml(nameWithoutExt)}</a></td>
  <td>${item.isDirectory() ? "Directory" : "File"}</td>
  <td><datetime>${stats.mtime.toISOString().split(".")[0]}</datetime></td>
</tr>
  `;
};

(async () => {
  const script_dir = import.meta.dir;
  const templates_dir = `${script_dir}/templates`;
  const template = `${templates_dir}/index.html`;

  const target = Bun.argv[2];
  const root = Bun.argv[3] ?? "dist";
  const target_dir = path.dirname(target);
  let subitems = await readdir(target_dir, { withFileTypes: true });
  subitems = subitems.filter((v) => {
    const ext = path.extname(v.name);
    return v.isDirectory() || (v.isFile() && v.name !== "index.html" && ext === ".html");
  });
  subitems.sort((a, b) => a.name.localeCompare(b.name));

  if (subitems.length === 1 && subitems[0].isFile()) {
    await Bun.write(target, Bun.file(path.join(target_dir, subitems[0].name)));
    return;
  }

  const rows = subitems.map(constructRow).join("\n");

  const rewriter = new HTMLRewriter();
  rewriter.on('link[rel="icon"]', {
    element: (link) => link.setAttribute("href", faviconPath(target, root)),
  });
  rewriter.on("title", {
    element: (title) =>
      title.setInnerContent(
        path.resolve(target_dir) === path.resolve(root)
          ? "Index"
          : toTitleCase(path.basename(target_dir)),
      ),
  });
  if (path.resolve(target_dir) === path.resolve(root)) {
    rewriter.on("#parent-dir-row", { element: (row) => row.remove() });
  }
  rewriter.on("#parent-dir-row", {
    element: (row) => row.after(rows, { html: true }),
  });

  const template_content = await Bun.file(template).arrayBuffer();
  const result = rewriter.transform(template_content);
  await Bun.write(target, result);
})();
